
# WorkBuddy local session data (memory logs, caches) — agent-owned, never commit
.workbuddy-ai/
.workbuddy/

# Artificial Analysis snapshot cache (regenerated by tools/fetch-personality.mjs)
.cache/

# Local runtime data: encrypted credentials, stats, live-model cache
# (may be created when running the server plugin from the repo root)
data/
.version.json
runs.json
*.tmp

# Local OAuth client ids/secrets (never commit these)
oauth-clients.json

# Locally rendered banner for forum posts (regenerate: resvg --width 2400 assets/readme-banner.svg assets/readme-banner.png)
assets/readme-banner.png
